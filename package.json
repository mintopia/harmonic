{
  "name": "@mintopia/harmonic",
  "version": "2.0.0",
  "description": "Queue, run, and review autonomous coding-agent tasks over ACP",
  "repository": "github:mintopia/harmonic",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "npm run build",
    "test": "vitest run",
    "test:coverage": "COVERAGE=1 vitest run --coverage",
    "dev": "tsx src/cli.ts serve",
    "docs:openapi": "tsx scripts/gen-openapi.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p web/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "harmonic": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/static": "^10.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/websocket": "^11.3.0",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dompurify": "^3.4.13",
    "drizzle-orm": "^0.45.2",
    "elkjs": "^0.10.2",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "marked": "^18.0.9",
    "nodemailer": "^9.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "smtp-server": "^3.19.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
